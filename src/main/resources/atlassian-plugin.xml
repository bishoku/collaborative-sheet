<atlassian-plugin key="com.bishokudev.confluence.sheets-confluence-dc" name="Collaborative Sheets" plugins-version="2">
  <plugin-info><description>Collaborative sheets with durable revision history</description><version>${project.version}</version><vendor name="Bishoku"/><param name="atlassian-licensing-enabled">false</param></plugin-info>
  <component-import key="ao" interface="com.atlassian.activeobjects.external.ActiveObjects"/>
  <component-import key="clusterLockService" interface="com.atlassian.beehive.ClusterLockService"/>
  <ao key="sheets-ao" namespace="com.bishokudev.sheets.v1"><entity>com.bishokudev.sheets.ao.Revision</entity></ao>
  <web-resource key="sheet-resources" name="Sheet resources">
    <dependency>com.atlassian.auiplugin:ajs</dependency>
    <resource type="download" name="sheets.js" location="js/sheets.js"/>
    <resource type="download" name="sheets.css" location="css/sheets.css"/>
    <context>page</context><context>editor</context>
  </web-resource>
  <xhtml-macro key="sheet" name="collaborative-sheet" class="com.bishokudev.sheets.SheetMacro">
    <description>Excel-like collaborative sheet. Use a unique sheet key per table on a page.</description>
    <category name="formatting"/>
    <parameters><parameter name="sheet" type="string" required="true" default="sheet-1"/></parameters>
  </xhtml-macro>
  <rest key="sheet-rest" path="/collaborative-sheets" version="1.0"><package>com.bishokudev.sheets.rest</package></rest>
</atlassian-plugin>
